{
  "name": "slack-github-action",
  "version": "1.0.10",
  "description": "Sends Slack notifications about the results of GitHub Actions workflows",
  "main": "dist/index.js",
  "scripts": {
    "start": "npm run build && node .",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.js",
    "lint": "oxlint src --type-aware",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "local": "esbuild src/local-index.ts --bundle --platform=node --format=cjs --outfile=build/local-index.js && node build/local-index.js"
  },
  "author": "Ruchira (Richie) Jayasekara <me@ruchij.com>",
  "license": "ISC",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@aws-sdk/client-ssm": "^3.1131.0",
    "@aws-sdk/client-sts": "^3.1131.0",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.1",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
